<?xml version="1.0" encoding="utf-8"?>
<!-- Ersetzt das unveränderte Capacitor-Standard-Platzhalterraster (Türkis
     plus Gitterlinien) durch den tatsächlichen Marken-Farbverlauf der App,
     entsprechend der gradient-primary-Variable aus style.css (135 Grad, von
     oklch 0.72/0.19/275 zu oklch 0.72/0.22/300), als Hex via Canvas-Rendering
     ermittelt. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#8496FF"
                android:endColor="#BC7BFF" />
        </aapt:attr>
    </path>
</vector>
