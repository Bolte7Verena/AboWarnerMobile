# Dependencies
node_modules/

# Build output (regenerated by `npm run build` / CI, not source)
www/

# Release artifacts (regenerated by CI going forward — see codemagic.yaml;
# kept out of git so signed binaries don't bloat repo history)
builds/

# Signing material — never commit, see android/keystore.properties handling
*.jks
*.keystore
keystore.properties
*.p8
*.mobileprovision
*.p12

# Fastlane: generierte Screenshots und lokal gebündelte Ruby-Gems — beides
# wird von Codemagic (ios-screenshots-Workflow) frisch erzeugt, nicht Teil
# der Quelle.
fastlane/screenshots/
vendor/bundle/
.bundle/

# Sicherungskopie der Xcode-Projektdatei vor dem Hinzufügen des
# UI-Test-Ziels (siehe MOBILE_STATUS.md) — zum Vergleich aufbewahrt, bis
# der erste echte Codemagic-Build das neue Ziel bestätigt hat.
*.pbxproj.bak-*

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
npm-debug.log*
