# Fastlane Snapshot — Konfiguration für automatisierte App-Store-Screenshots.
# Läuft nur im iOS-Simulator auf macOS (Codemagic-Cloud-Build), hier unter
# Windows nicht ausführbar, nur konfiguriert/vorbereitet.

# Pflichtgrößen für die App-Store-Connect-Einreichung: 6.9" (iPhone) und
# 13" (iPad) — Letzteres, weil TARGETED_DEVICE_FAMILY = "1,2" (Universal).
# Diese Namen sind KEIN Rätselraten mehr, sondern stammen direkt aus der
# Fehlermeldung eines echten Codemagic-Builds ("not in list of available
# simulators" nannte die tatsächlich installierten Geräte). Falls ein
# künftiges Xcode-Image die Namen wieder ändert, zeigt Fastlane erneut die
# aktuell verfügbaren Simulatoren an — dann hier anpassen.
devices([
  "iPhone 17 Pro Max",
  "iPad Pro 13-inch (M5)"
])

# Die App-Oberfläche ist ausschließlich auf Deutsch, daher nur eine Sprache.
languages(["de-DE"])

project("ios/App/App.xcodeproj")
scheme("App")

output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)

# Setzt eine einheitliche, saubere iOS-Statusleiste (volle Akkuanzeige, feste
# Uhrzeit, WLAN) in allen Screenshots — wichtig, damit nichts vom zuvor
# genutzten Android-Gerät durchscheint.
override_status_bar(true)

stop_after_first_error(false)
concurrent_simulators(false)
